# ==============================================================================
# TRUENORTH GROUP CMS — ADMIN DIRECTORY .HTACCESS
# Enforces clean URLs, strips .php, and rewrites clean routes to php files
# ==============================================================================

DirectoryIndex index.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /admin/

    # Force canonical HTTPS host here too: a sub-directory RewriteEngine stops
    # the root .htaccess rules from running for /admin and /public
    RewriteCond %{HTTP_HOST} ^www\.wetruenorthgroup\.com$ [NC]
    RewriteRule ^ https://wetruenorthgroup.com%{REQUEST_URI} [R=301,L]
    RewriteCond %{HTTP_HOST} !^(127\.0\.0\.1|localhost)(:\d+)?$ [NC]
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP:X-Forwarded-Proto} !https
    RewriteRule ^ https://wetruenorthgroup.com%{REQUEST_URI} [R=301,L]

    # 1. 301 Redirect direct requests for index.php to /admin
    RewriteCond %{THE_REQUEST} \s/admin/index\.php[?\s] [NC]
    RewriteRule ^index\.php$ /admin [R=301,L]

    # 2. 301 Redirect any direct request for /admin/xyz.php to /admin/xyz
    RewriteCond %{THE_REQUEST} \s/admin/([a-zA-Z0-9_-]+)\.php[?\s] [NC]
    RewriteRule ^([a-zA-Z0-9_-]+)\.php$ /admin/%1 [R=301,L]

    # 3. Rewrite extensionless requests /admin/xyz to xyz.php internally
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^([a-zA-Z0-9_-]+)/?$ $1.php [L,QSA]
</IfModule>

# 4. Never edge-cache the admin panel (LiteSpeed AJCC) — each request must
#    reach PHP for auth checks; cached admin HTML would leak sessions.
<IfModule LiteSpeed>
    CacheLookup "private"
</IfModule>
