# ==============================================================================
# TRUENORTH GROUP — ULTRA-COMPATIBLE CPANEL .HTACCESS
# Designed specifically to eliminate "HTTP ERROR 500" on cPanel / Shared Hosting
# ==============================================================================

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block direct web access to sensitive files & config directory
    RewriteRule ^config/ - [F,L]
    RewriteRule \.(sql|log|git|env|json)$ - [F,L]

    # Automatic WebP delivery for legacy .jpg/.png requests
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
    RewriteRule ^(.+)\.(jpe?g|png)$ $1.webp [T=image/webp,L]

    # --- CLEAN & SHORT URLS ---
    # Short URL: /login -> /admin/login
    RewriteRule ^login/?$ /admin/login [R=301,L]

    # 301 Redirect direct external requests for /admin/index.php to /admin
    RewriteCond %{THE_REQUEST} \s/admin/index\.php[?\s] [NC]
    RewriteRule ^admin/index\.php$ /admin [R=301,L]

    # 301 Redirect any direct external request for /admin/*.php to /admin/*
    RewriteCond %{THE_REQUEST} \s/admin/([a-zA-Z0-9_-]+)\.php[?\s] [NC]
    RewriteRule ^admin/([a-zA-Z0-9_-]+)\.php$ /admin/$1 [R=301,L]

    # 2. Do not rewrite existing files, images, or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Route all other requests through index.php
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType application/manifest+json .webmanifest
    AddType application/xml .xml
    AddType text/plain .txt
</IfModule>

