# ==============================================================================
# TRUENORTH GROUP — ULTRA-COMPATIBLE CPANEL .HTACCESS
# Designed specifically to eliminate "HTTP ERROR 500" on cPanel / Shared Hosting
# ==============================================================================

DirectoryIndex index.php index.html

<IfModule mod_rewrite.c>
    RewriteEngine On

    # 1. Block direct web access to sensitive files & config directory
    RewriteRule ^config/ - [F,L]
    RewriteRule \.(sql|log|git|env|json)$ - [F,L]

    # Automatic WebP delivery for legacy .jpg/.png requests
    RewriteCond %{HTTP_ACCEPT} image/webp
    RewriteCond %{DOCUMENT_ROOT}/$1.webp -f
    RewriteRule ^(.+)\.(jpe?g|png)$ $1.webp [T=image/webp,L]

    # 2. Do not rewrite existing files, images, or directories
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 3. Route all other requests through index.php
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_mime.c>
    AddType image/webp .webp
    AddType application/manifest+json .webmanifest
    AddType application/xml .xml
    AddType text/plain .txt
</IfModule>

